ENV_FILE_PATH=.env
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.1
AIRFLOW_UID=50000
_PIP_ADDITIONAL_REQUIREMENTS=
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:change_me_postgres_password@postgres/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:change_me_postgres_password@postgres/airflow
AIRFLOW__CELERY__BROKER_URL=redis://:@redis:6379/0
AIRFLOW__CELERY__WORKER_CONCURRENCY=8
AIRFLOW__CORE__PARALLELISM=64
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=32
AIRFLOW__SCHEDULER__MAX_TIS_PER_QUERY=32
AIRFLOW__CELERY__POOL=prefork
AIRFLOW__CELERY__CELERY_CONFIG_OPTIONS=airflow.providers.celery.executors.default_celery.DEFAULT_CELERY_CONFIG
FERNET_KEY=zL9m0Qm2x7Kv4pW9u1iX8l3M2Wk0m3n2bL0h2s5dQ1E=
AIRFLOW__API_AUTH__JWT_SECRET=change_me_api_jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me_admin_password
MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=change_me_mongo_password
MONGO_DB=parfum
MONGO_PORT=27017
AIRFLOW_CONN_MONGO_DEFAULT=mongodb://mongoadmin:change_me_mongo_password@mongodb:27017/parfum

# Pipeline settings
ULTA_BASE_URL=https://www.ulta.com/shop/fragrance/all
ULTA_MAX_PAGES=500
ULTA_DETAIL_BATCH_SIZE=100
